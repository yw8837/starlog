<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Starlog" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/site_background</item>
        <item name="android:colorAccent">@color/brand_gold</item>
    </style>

    <!-- Launch theme (androidx core-splashscreen): site background + the brand star, then Theme.Starlog. -->
    <style name="Theme.Starlog.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/site_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Starlog</item>
    </style>
</resources>
