<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: allowBackup="false" already disables backup and transfer there; these rules only repeat
     data_extraction_rules.xml (nothing of the app's data leaves the device) for any device that still reads them. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
