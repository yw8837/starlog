{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "starlog",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // enable_request_signal: request.signal aborts when the client disconnects, so a streamed
  // generation cancels its upstream call (lib/api/stream.ts).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "enable_request_signal"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "starlog"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Production origin (SITE.url). Wrangler creates the DNS record and certificate on deploy.
  "routes": [{ "pattern": "starlog.yeolmaeapps.kr", "custom_domain": true }],
  "workers_dev": true,
  // Per-IP limits for AI generation (lib/security/rateLimit.ts LIMITS_PER_MINUTE must match).
  // Owners get the 5x limiters; full readings have their own tighter one; owner-code attempts too.
  "ratelimits": [
    { "name": "GEN_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "OWNER_GEN_LIMITER", "namespace_id": "1002", "simple": { "limit": 150, "period": 60 } },
    { "name": "OWNER_LOGIN_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    { "name": "FULL_LIMITER", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
    { "name": "OWNER_FULL_LIMITER", "namespace_id": "1005", "simple": { "limit": 25, "period": 60 } }
  ],
  // 오늘의 한 장 results, one per device per KST day (lib/api/dailyStore.ts).
  "kv_namespaces": [
    { "binding": "DAILY_KV", "id": "fbb538757609409c94a386390809926a" }
  ]
}
