{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "starlog",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "starlog"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Per-IP limits for AI generation (lib/security/quota.ts LIMITS_PER_MINUTE must match).
  // Owners get the 5x limiter; owner-code attempts have their own small one.
  "ratelimits": [
    { "name": "GEN_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "OWNER_GEN_LIMITER", "namespace_id": "1002", "simple": { "limit": 150, "period": 60 } },
    { "name": "OWNER_LOGIN_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ]
}
