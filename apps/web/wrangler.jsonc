{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "starlog",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // enable_request_signal: request.signal aborts when the client disconnects, so a streamed
  // generation cancels its upstream call (lib/api/stream.ts).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "enable_request_signal"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "starlog"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Run the Worker near Tokyo. Korean visitors on Cloudflare's free zone plan are often served from
  // other colos (e.g. Hong Kong), and the Anthropic API answers 403 "Request not allowed" to requests
  // leaving from unsupported regions. Tokyo is supported and ~30 ms from Korea.
  "placement": { "region": "aws:ap-northeast-1" },
  // Production origin (SITE.url). Wrangler creates the DNS record and certificate on deploy.
  "routes": [{ "pattern": "starlog.yeolmaeapps.kr", "custom_domain": true }],
  "workers_dev": true,
  // Public-beta cost cap per KST day in KRW (lib/api/spend.ts trips at 80%). Prepaid Anthropic credits
  // with auto-reload off are the hard backstop.
  "vars": { "BETA_DAILY_BUDGET_KRW": "15000" },
  // Per-IP limits for AI generation (lib/security/rateLimit.ts LIMITS_PER_MINUTE must match).
  // Owners get the 5x limiters; full readings have their own tighter one; owner-code attempts too.
  "ratelimits": [
    { "name": "GEN_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "OWNER_GEN_LIMITER", "namespace_id": "1002", "simple": { "limit": 150, "period": 60 } },
    { "name": "OWNER_LOGIN_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    { "name": "FULL_LIMITER", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
    { "name": "OWNER_FULL_LIMITER", "namespace_id": "1005", "simple": { "limit": 25, "period": 60 } },
    // 별자리 인연 per IP: joins and new owners; failed invite-code lookups (strict); real code opens and
    // share images (generous, link-preview crawlers included). Values match lib/security/rateLimit.ts.
    { "name": "BOND_JOIN_LIMITER", "namespace_id": "1006", "simple": { "limit": 10, "period": 60 } },
    { "name": "BOND_CODE_LIMITER", "namespace_id": "1007", "simple": { "limit": 10, "period": 60 } },
    { "name": "BOND_VIEW_LIMITER", "namespace_id": "1008", "simple": { "limit": 120, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1101", "simple": { "limit": 20, "period": 60 } },
    { "name": "PAY_LIMITER", "namespace_id": "1102", "simple": { "limit": 20, "period": 60 } },
    { "name": "WEBHOOK_LIMITER", "namespace_id": "1103", "simple": { "limit": 60, "period": 60 } }
  ],
  // 오늘의 한 장 results, one per device per KST day (lib/api/dailyStore.ts).
  "kv_namespaces": [
    { "binding": "DAILY_KV", "id": "fbb538757609409c94a386390809926a" }
  ],
  // App data (lib/db): 별자리 인연 first. Schema in migrations/, applied with
  // `npx wrangler d1 migrations apply starlog --remote` before a deploy that needs it.
  "d1_databases": [
    { "binding": "DB", "database_name": "starlog", "database_id": "78c6fb07-ee97-42d5-9633-21801fe596eb", "migrations_dir": "migrations" }
  ]
}
