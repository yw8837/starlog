{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  // The Anthropic API proxy for the "starlog" Worker (./worker.mjs). Deploy it before a main Worker that binds it:
  //   cd apps/web && npx wrangler deploy -c ai-proxy/wrangler.jsonc
  //   npx wrangler secret put ANTHROPIC_API_KEY -c ai-proxy/wrangler.jsonc   (the key lives here, not in the main Worker)
  // Check after a deploy: GET /_placement through the binding answers {colo, anthropic: 401}; never colo HKG or 403.
  "name": "starlog-ai",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  // enable_request_signal: request.signal aborts when the main Worker drops the call, so the upstream call ends too.
  "compatibility_flags": ["global_fetch_strictly_public", "enable_request_signal"],
  // Run near the Anthropic API. Korean visitors on the free zone plan are often served from Hong Kong, where the API
  // answers 403 "Request not allowed"; "region": "aws:ap-northeast-1" stopped being applied on 2026-10-15, and this
  // hostname hint placed a probe outside Hong Kong 12 of 12 times (MIA). Only this Worker pays the far round trip.
  "placement": { "hostname": "api.anthropic.com" },
  // Reached only through service bindings: no route, no workers.dev address, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
