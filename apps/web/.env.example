# Copy to .env.local (never commit real values).

# Claude API key for AI readings. Production without it answers 503 (no canned readings);
# local dev without it uses the mock provider.
ANTHROPIC_API_KEY=
# Signs draw tokens, quota and owner cookies (32+ random characters; required in production).
STARLOG_SIGNING_SECRET=
# Owner pass code for /owner (skips beta quotas on that device). Never put it in a URL.
STARLOG_OWNER_CODE=
# "mock" forces the deterministic mock provider (tests, e2e). Leave empty in production.
STARLOG_AI=
# Beta quotas per device per KST day (defaults 3 / 20 / 2 / 15, follow-ups 3 per chapter).
BETA_FULL_PER_DAY=
BETA_TEASER_PER_DAY=
BETA_DAILY_PER_DAY=
BETA_FOLLOWUPS_PER_DAY=
BETA_FOLLOWUPS_PER_CHAPTER=

# Google AdSense (guide pages only). Leave empty to keep ads off.
# Publisher id: ca-pub- followed by 16 digits. Keep Auto ads OFF in the AdSense dashboard.
ADSENSE_CLIENT=
# Ad unit id for the slot under guide articles (digits only).
ADSENSE_SLOT_GUIDE=
