# Copy to .env.local (never commit real values).

# Claude API key for AI readings. Production without it answers 503 (no canned readings);
# local dev without it uses the mock provider.
ANTHROPIC_API_KEY=
# Signs draw tokens, quota and owner cookies (32+ random characters; required in production).
STARLOG_SIGNING_SECRET=
# Owner pass code for /owner (skips beta quotas on that device). Never put it in a URL.
STARLOG_OWNER_CODE=
# "mock" forces the deterministic mock provider (tests, e2e). Leave empty in production.
STARLOG_AI=
# Beta quotas per device per KST day, kept in a signed cookie (defaults: full 1, teaser 5,
# daily 2, follow-ups 15; follow-ups 3 per chapter, also counted server-side per chapter).
BETA_FULL_PER_DAY=
BETA_TEASER_PER_DAY=
BETA_DAILY_PER_DAY=
BETA_FOLLOWUPS_PER_DAY=
BETA_FOLLOWUPS_PER_CHAPTER=
# Server-side limits per client network (IP, IPv6 by /64; stored only as an HMAC) per KST day,
# counted in DAILY_KV whatever the cookies say. They only stop one abuser: carriers (CGNAT) and
# office/school/café Wi-Fi put many people on one IP, and the daily budget below is the real cost cap.
# Defaults: full 60, teaser 240, daily 120, follow-ups 300, 인연 lines 120.
BETA_IP_FULL_PER_DAY=
BETA_IP_TEASER_PER_DAY=
BETA_IP_DAILY_PER_DAY=
BETA_IP_FOLLOWUPS_PER_DAY=
BETA_IP_LINES_PER_DAY=
# Global estimated Claude spend per KST day in KRW (default 30000; 0 stops all new readings).
# New generations answer 503 AI_UNAVAILABLE, owner included, once the estimate reaches 80% of it
# (KV can lose concurrent updates), and full readings/teasers also while KV cannot be read.
# KRW_PER_USD (default 1500: the rate plus a VAT/FX margin) converts the list prices in lib/ai/cost.ts.
BETA_DAILY_BUDGET_KRW=
KRW_PER_USD=

# Google AdSense (guide pages only). Leave empty to keep ads off.
# Publisher id: ca-pub- followed by 16 digits. Keep Auto ads OFF in the AdSense dashboard.
ADSENSE_CLIENT=
# Ad unit id for the slot under guide articles (digits only).
ADSENSE_SLOT_GUIDE=

# Search engine ownership codes (build time: set them in .env.local before `pnpm deploy`, then
# redeploy; empty values add no tag). Steps: docs/seo/indexing-runbook.md.
# Google Search Console, "HTML 태그" method: only the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# 네이버 서치어드바이저, "HTML 태그" method: only the content="..." value (naver-site-verification).
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
# Bing Webmaster Tools, "HTML Meta Tag" method: only the content="..." value (msvalidate.01).
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Daum 웹마스터도구: the robots.txt line it gives, "#DaumWebMasterTool:...:..." (whole line, or the part after the first colon).
NEXT_PUBLIC_DAUM_WEBMASTER_TOOL=

# ---- P4 accounts and payments (docs/runbook-payments.md) ----
# off (default: no login or payments) | owner (only owner-pass devices) | on | paused (rollback: no new sales, logins still work)
STARLOG_PAYMENTS=
# toss (default) | mock (in-memory Toss for tests, e2e and local dev; refused in production)
STARLOG_PAY=
# kakao (default) | mock (mock:<name> codes for tests and e2e; refused in production)
STARLOG_KAKAO=
# Toss Payments widget keys: both test_ or both live_ (the server refuses a mixed pair).
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Kakao Login: REST API key and client secret (app console > 앱 > 플랫폼 키 > REST API 키).
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 32+ random characters. Keys Kakao lookups and encrypts saved readings. NEVER rotate it: D1 pins
# it (meta.account_secret_check) and account routes answer 503 when it changes.
STARLOG_ACCOUNT_SECRET=
# 32+ random characters. The Cron Trigger's bearer token for /api/internal/maintenance.
STARLOG_CRON_SECRET=
# 1 = `next dev` gets local D1, KV and limiters through Miniflare (run db:migrate:local first).
STARLOG_CF_DEV=
# Card-company review account (Toss contract review): the hidden /login/review takes this ID and
# password. Both set = on while STARLOG_PAYMENTS is owner or on (one fixed account, no signup gift,
# may pay on test keys like the owner pass); either empty, a password under 20 characters, or
# STARLOG_PAYMENTS off or paused = the page and /api/auth/review answer 404.
# A long random password; remove both after the review.
REVIEW_LOGIN_ID=
REVIEW_LOGIN_PASSWORD=

# ---- P5 premium readings (docs/runbook-premium.md) ----
# off (default) | owner (owner-pass devices only) | on. Needs STARLOG_PAYMENTS open for the device.
STARLOG_PREMIUM=

# ---- 주제별 사주 (docs/runbook-deploy.md) ----
# off | owner | on, read at build time by the screens and the server. Empty: on in dev and tests, off
# in production. owner shows the row "다른 운도 볼 수 있어요" only on the owner pass's device.
NEXT_PUBLIC_SAJU_TOPICS=
