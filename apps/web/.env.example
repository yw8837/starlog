# Copy to .env.local (never commit real values).

# Claude API key for AI readings. Production without it answers 503 (no canned readings);
# local dev without it uses the mock provider.
ANTHROPIC_API_KEY=
# Signs draw tokens, quota and owner cookies (32+ random characters; required in production).
STARLOG_SIGNING_SECRET=
# Owner pass code for /owner (skips beta quotas on that device). Never put it in a URL.
STARLOG_OWNER_CODE=
# "mock" forces the deterministic mock provider (tests, e2e). Leave empty in production.
STARLOG_AI=
# Beta quotas per device per KST day, kept in a signed cookie (defaults: full 1, teaser 5,
# daily 2, follow-ups 15; follow-ups 3 per chapter, also counted server-side per chapter).
BETA_FULL_PER_DAY=
BETA_TEASER_PER_DAY=
BETA_DAILY_PER_DAY=
BETA_FOLLOWUPS_PER_DAY=
BETA_FOLLOWUPS_PER_CHAPTER=
# Server-side limits per client network (IP, IPv6 by /64; stored only as an HMAC) per KST day,
# counted in DAILY_KV whatever the cookies say. Generous because carriers share IPs.
# Defaults: full 10, teaser 40, daily 20, follow-ups 60.
BETA_IP_FULL_PER_DAY=
BETA_IP_TEASER_PER_DAY=
BETA_IP_DAILY_PER_DAY=
BETA_IP_FOLLOWUPS_PER_DAY=
# Global estimated Claude spend per KST day in KRW (default 30000; 0 stops all new readings).
# Over it, new generations answer 503 AI_UNAVAILABLE, owner included. KRW_PER_USD (default 1400)
# converts the list prices in lib/ai/cost.ts.
BETA_DAILY_BUDGET_KRW=
KRW_PER_USD=

# Google AdSense (guide pages only). Leave empty to keep ads off.
# Publisher id: ca-pub- followed by 16 digits. Keep Auto ads OFF in the AdSense dashboard.
ADSENSE_CLIENT=
# Ad unit id for the slot under guide articles (digits only).
ADSENSE_SLOT_GUIDE=
