{
  "name": "starlog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "pnpm --filter @starlog/web dev",
    "build": "pnpm --filter @starlog/web build && node scripts/check-client-bundle.mjs",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "check:worker": "node scripts/check-worker-size.mjs",
    "check:worker-env": "node scripts/check-worker-env.mjs",
    "cf:build": "pnpm --filter @starlog/web cf:build && node scripts/check-client-bundle.mjs",
    "deploy": "pnpm cf:build && node scripts/check-worker-env.mjs && pnpm --filter @starlog/web cf:deploy",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && pnpm --filter @starlog/web typecheck",
    "cards:build": "python scripts/build-cards.py",
    "e2e": "pnpm --filter @starlog/web e2e",
    "e2e:screens": "pnpm --filter @starlog/web e2e:screens",
    "kb:runtime": "node scripts/build-kb-runtime.mjs",
    "kb:i18n": "node scripts/build-kb-i18n.mjs",
    "ai:smoke": "vitest run -c vitest.smoke.config.ts scripts/ai-smoke.test.ts",
    "ai:check:saju-topics": "vitest run -c vitest.smoke.config.ts scripts/saju-topics-real.test.ts",
    "ai:premium": "vitest run -c vitest.premium.config.ts",
    "i18n:status": "vitest run -c vitest.i18n.config.ts scripts/i18n/status.test.ts",
    "i18n:ledger": "vitest run -c vitest.i18n.config.ts scripts/i18n/ledger-write.test.ts",
    "i18n:review": "vitest run -c vitest.i18n.config.ts scripts/i18n/review.test.ts",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
