{
  "name": "starlog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "pnpm --filter @starlog/web dev",
    "build": "pnpm --filter @starlog/web build && node scripts/check-client-bundle.mjs",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "cf:build": "pnpm --filter @starlog/web cf:build && node scripts/check-client-bundle.mjs",
    "deploy": "pnpm cf:build && pnpm --filter @starlog/web cf:deploy",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && pnpm --filter @starlog/web typecheck",
    "cards:build": "node scripts/build-cards.mjs",
    "e2e": "pnpm --filter @starlog/web e2e",
    "e2e:screens": "pnpm --filter @starlog/web e2e:screens",
    "kb:runtime": "node scripts/build-kb-runtime.mjs",
    "ai:smoke": "vitest run -c vitest.smoke.config.ts",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
